# Compass backend configuration
# Copy this file to .env. DB_URI has no implicit SQLite fallback and is required.
HOST=0.0.0.0
PORT=8000
DB_URI=postgresql://compass:change-me@localhost:5432/compass

# Local development defaults. Cloud mode validates all three security settings.
COMPASS_CLOUD_MODE=false
JWT_SECRET=compass-dev-secret-change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=
SECURE_COOKIES=false

# Comma-separated web origins allowed to send credentialed requests.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
WORKSPACE_ROOT=.compass/workspaces

# Defaults used when a user has not selected a BYOK provider/model.
DEFAULT_PROVIDER=openrouter
DEFAULT_MODEL=google/gemma-4-31b-it:free

# Optional semantic-memory capability. Both values are required to report it available.
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=

# Optional local MCP configuration file. Leave unset when MCP is disabled.
MCP_SERVERS_FILE=

# Optional OAuth integrations.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional frontend override; /api is used when omitted.
VITE_API_URL=/api
